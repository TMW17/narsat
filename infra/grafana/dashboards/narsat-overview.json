          },
          "expr": "sum by (target) (rate(narsat_hotspots_stored_total[$__rate_interval]))",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
