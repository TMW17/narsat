# Web application settings (read at build time by Vite). Copy to .env.local to change them.

# Base URL of the NarSat REST API. The default works behind the bundled nginx and with
# the development proxy of `npm run dev`.
VITE_API_BASE_URL=/api/v1

# MapLibre style of the base map. OpenFreeMap is free, needs no key and is based on
# OpenStreetMap data. If the style cannot be loaded the map falls back to a plain
# background, so the application also works offline.
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
