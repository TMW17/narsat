# NarSat configuration for `docker compose`. Copy this file to .env and fill it in:
#
#   cp .env.example .env
#
# .env is listed in .gitignore: it must never be committed.
#
# Passwords and keys are placed inside connection URLs, so use letters and digits only.
# A quick way to generate one:   openssl rand -hex 24

# ------------------------------------------------------------------ required
# NASA FIRMS key, free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without it every other service runs, but no live fire detections are ingested.
NARSAT_FIRMS_MAP_KEY=

# Database superuser (only used by the database container itself).
POSTGRES_PASSWORD=
# Password of the "narsat" database user (platform data and Iceberg catalog).
NARSAT_DB_PASSWORD=
# Password of the "airflow" database user (orchestration profile).
AIRFLOW_DB_PASSWORD=

# Credentials of the S3 object store (SeaweedFS) that holds the lakehouse.
NARSAT_S3_ACCESS_KEY=narsat
NARSAT_S3_SECRET_KEY=

# Signs the API's login tokens. At least 32 characters.
NARSAT_API_JWT_SECRET=

# Airflow web interface (http://localhost:8081, user "admin") and its internal tokens.
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=

# Grafana (http://localhost:3000, user "admin"), observability profile.
GRAFANA_ADMIN_PASSWORD=

# ------------------------------------------------------------------ optional
# dev | prod. In prod the API refuses to start with the development token secret.
NARSAT_ENV=dev
NARSAT_LOG_LEVEL=INFO

# Countries whose administrative units are used for attribution (ISO 3166-1 alpha-3).
NARSAT_AOI_COUNTRIES=DZA,MAR,TUN

# FIRMS products polled. Near-real-time products cover roughly the last two months;
# use the *_SP (standard processing) products with `narsat firms backfill` for history.
NARSAT_FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT

# Burned-area methods: "dnbr" needs nothing else; add "model" once the inference service
# runs (`docker compose --profile ml up -d`, or natively on the Mac, see
# services/inference/README.md, then set NARSAT_SEG_INFERENCE_URL=http://host.docker.internal:8090).
NARSAT_SEG_METHODS=dnbr
NARSAT_SEG_INFERENCE_URL=http://inference:8080

# Pin the Prithvi weights to a Hugging Face commit for reproducible results.
NARSAT_INFERENCE_MODEL_REVISION=main

# Host port of PostgreSQL, if 5432 is already used on this machine.
POSTGRES_HOST_PORT=5432

# Tag given to the images built by `docker compose build`.
NARSAT_VERSION=dev
